#!/usr/bin/env zunit
#
# -*- mode: zsh; sh-indentation: 2; indent-tabs-mode: nil; sh-basic-offset: 2; -*-
# vim: ft=zsh sw=2 ts=2 et
#

@setup {
  load setup
  load helpers
  setup
}

@teardown {
  load setup
  teardown
}

@test 'startup failure returns without exiting the shell when eza is missing' {
  run_zsh_eza_shell '
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    rc=$?
    print -- "rc=${rc}"
    print -- "after-source"
  ' "${ZSH_EZA_TEST_EMPTY_PATH}"

  assert $state equals 0
  assert "$output" contains 'Please install eza before using this plugin.'
  assert "$output" contains 'Error loading zsh-eza plugin, exit code: 1'
  assert "$output" contains 'rc=1'
  assert "$output" contains 'after-source'
}

@test 'entrypoint preserves caller 0 and resolves its directory' {
  make_fake_eza

  local option_mode source_mode
  for option_mode in default no_function_argzero posix_argzero; do
    for source_mode in direct manager_zero; do
      run_zsh_eza_entrypoint_state "$option_mode" "$source_mode"

      assert $state equals 0
      assert "$output" contains "mode=${option_mode}/${source_mode}"
      assert "$output" contains 'rc=0'
      assert "$output" contains 'caller-zero-preserved=yes'
      assert "$output" contains "plugin-dir=${ZSH_EZA_REPO}"
      assert "$output" contains 'resource-zero-preserved=yes'
    done
  done
}

@test 'isolated shell does not inherit unrelated environment variables' {
  export ZSH_EZA_TEST_SENTINEL='zsh-eza-sensitive-sentinel'

  run_zsh_eza_shell '
    print -- "sentinel=${ZSH_EZA_TEST_SENTINEL-unset}"
  '

  unset ZSH_EZA_TEST_SENTINEL

  assert $state equals 0
  assert "$output" contains 'sentinel=unset'
  assert "$output" does_not_contain 'zsh-eza-sensitive-sentinel'
}

@test 'helper fails clearly when zsh is not on PATH' {
  local saved_path=$PATH
  export ZSH_EZA_TEST_SENTINEL='zsh-eza-sensitive-sentinel'
  PATH=$ZSH_EZA_TEST_EMPTY_PATH

  run_zsh_eza_shell 'print -- "unexpected child execution"'

  PATH=$saved_path
  unset ZSH_EZA_TEST_SENTINEL

  assert $state equals 127
  assert "$output" contains 'zsh-eza test helper: zsh not found on PATH'
  assert "$output" does_not_contain 'zsh-eza-sensitive-sentinel'
}

@test 'scalar custom params are split into separate eza arguments' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" user-params "--git --icons"
    zstyle ":zsh-eza:config" extra-params "--classify --tree"
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    eval "${aliases[ls]}"
  '

  assert $state equals 0
  assert "$output" contains 'fake-eza [--git] [--icons] [--classify] [--tree]'
}

@test 'unload restores aliases and removes the autocd hook' {
  make_fake_eza

  run_zsh_eza_shell '
    alias ls="ls --color=auto"
    zstyle ":zsh-eza:config" autocd yes
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    print -- "loaded=${aliases[ls]}"

    if [[ ${chpwd_functions[(r)_zsh_eza_auto_list]} == _zsh_eza_auto_list ]]; then
      print -- "hook=present"
    fi

    zsh-eza_plugin_unload
    print -- "restored=${aliases[ls]}"

    if (( ${+functions[_zsh_eza_auto_list]} )); then
      print -- "hook-function=present"
    else
      print -- "hook-function=removed"
    fi

    if [[ ${chpwd_functions[(r)_zsh_eza_auto_list]} == _zsh_eza_auto_list ]]; then
      print -- "hook-entry=present"
    else
      print -- "hook-entry=removed"
    fi
  '

  assert $state equals 0
  assert "$output" contains 'loaded=eza ${(@)_zsh_eza_params}'
  assert "$output" contains 'hook=present'
  assert "$output" contains 'restored=ls --color=auto'
  assert "$output" contains 'hook-function=removed'
  assert "$output" contains 'hook-entry=removed'
}

@test 'default _zsh_eza_params contains all six expected flags' {
  make_fake_eza

  run_zsh_eza_shell '
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    print -- "${_zsh_eza_params[@]}"
  '

  assert $state equals 0
  assert "$output" contains '--git'
  assert "$output" contains '--icons'
  assert "$output" contains '--group'
  assert "$output" contains '--group-directories-first'
  assert "$output" contains '--time-style=long-iso'
  assert "$output" contains '--color-scale=all'
}

@test 'all eight ls-style aliases are defined after load' {
  make_fake_eza

  run_zsh_eza_shell '
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    for a in ls l ll llm la lx lt tree; do
      if (( ${+aliases[$a]} )); then
        print -- "alias:${a}=present"
      else
        print -- "alias:${a}=missing"
      fi
    done
  '

  assert $state equals 0
  assert "$output" contains 'alias:ls=present'
  assert "$output" contains 'alias:l=present'
  assert "$output" contains 'alias:ll=present'
  assert "$output" contains 'alias:llm=present'
  assert "$output" contains 'alias:la=present'
  assert "$output" contains 'alias:lx=present'
  assert "$output" contains 'alias:lt=present'
  assert "$output" contains 'alias:tree=present'
}

@test 'ls alias invokes eza with all default params' {
  make_fake_eza

  run_zsh_eza_shell '
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    eval "${aliases[ls]}"
  '

  assert $state equals 0
  assert "$output" contains 'fake-eza'
  assert "$output" contains '[--git]'
  assert "$output" contains '[--icons]'
  assert "$output" contains '[--group-directories-first]'
  assert "$output" contains '[--time-style=long-iso]'
  assert "$output" contains '[--color-scale=all]'
}

@test 'll alias prepends --all --header --long before the params' {
  make_fake_eza

  run_zsh_eza_shell '
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    eval "${aliases[ll]}"
  '

  assert $state equals 0
  assert "$output" contains 'fake-eza [--all] [--header] [--long] [--git]'
}

@test 'la alias prepends -lbhHigUmuSa before the params' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" extra-params "--extra-flag"
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    eval "${aliases[la]}"
  '

  assert $state equals 0
  assert "$output" contains 'fake-eza [-lbhHigUmuSa] [--git]'
  assert "$output" contains '[--extra-flag]'
}

@test 'lx alias prepends -lbhHigUmuSa@ before the params' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" extra-params "--extra-flag"
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    eval "${aliases[lx]}"
  '

  assert $state equals 0
  assert "$output" contains 'fake-eza [-lbhHigUmuSa@] [--git]'
  assert "$output" contains '[--extra-flag]'
}

@test 'user-params replaces default params entirely' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" user-params "--only-this"
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    if [[ "${(j: :)_zsh_eza_params}" == "--only-this" ]]; then
      print -- "params=replaced"
    else
      print -- "params=not-replaced:${(j: :)_zsh_eza_params}"
    fi
    eval "${aliases[ls]}"
  '

  assert $state equals 0
  assert "$output" contains 'params=replaced'
  assert "$output" contains 'fake-eza [--only-this]'
}

@test 'extra-params appends to default params without replacing them' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" extra-params "--extra-flag"
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    if [[ "${_zsh_eza_params[-1]}" == "--extra-flag" ]]; then
      print -- "extra=appended"
    else
      print -- "extra=not-appended:last=${_zsh_eza_params[-1]}"
    fi
    if [[ "${_zsh_eza_params[1]}" == "--git" ]]; then
      print -- "defaults=preserved"
    else
      print -- "defaults=missing:first=${_zsh_eza_params[1]}"
    fi
    if [[ "${_zsh_eza_params[(r)--icons]}" == "--icons" ]]; then
      print -- "middle=preserved"
    else
      print -- "middle=missing"
    fi
  '

  assert $state equals 0
  assert "$output" contains 'extra=appended'
  assert "$output" contains 'defaults=preserved'
  assert "$output" contains 'middle=preserved'
}

@test 'autocd yes registers the hook in chpwd_functions' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" autocd yes
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    if [[ ${chpwd_functions[(r)_zsh_eza_auto_list]} == _zsh_eza_auto_list ]]; then
      print -- "hook=registered"
    else
      print -- "hook=absent"
    fi
  '

  assert $state equals 0
  assert "$output" contains 'hook=registered'
}

@test 'autocd unset does not register the chpwd hook' {
  make_fake_eza

  run_zsh_eza_shell '
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    if [[ ${chpwd_functions[(r)_zsh_eza_auto_list]} == _zsh_eza_auto_list ]]; then
      print -- "hook=registered"
    else
      print -- "hook=absent"
    fi
  '

  assert $state equals 0
  assert "$output" contains 'hook=absent'
}

@test '_zsh_eza_auto_list hook invokes eza with default params' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" autocd yes
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    _zsh_eza_auto_list
  '

  assert $state equals 0
  assert "$output" contains 'fake-eza'
  assert "$output" contains '[--git]'
  assert "$output" contains '[--icons]'
}

@test 'dumb terminal returns 0 silently and sets no aliases' {
  make_fake_eza

  run_zsh_eza_dumb_shell '
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    rc=$?
    print -- "rc=${rc}"
    if (( ! ${+aliases[ls]} )); then
      print -- "ls=not-aliased"
    else
      print -- "ls=aliased"
    fi
  '

  assert $state equals 0
  assert "$output" contains 'rc=0'
  assert "$output" contains 'ls=not-aliased'
}

@test 'unload with no prior aliases removes them without error' {
  make_fake_eza

  run_zsh_eza_shell '
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    zsh-eza_plugin_unload
    rc=$?
    print -- "rc=${rc}"
    if (( ! ${+aliases[ls]} )); then
      print -- "ls=removed"
    else
      print -- "ls=still-present"
    fi
  '

  assert $state equals 0
  assert "$output" contains 'rc=0'
  assert "$output" contains 'ls=removed'
}

@test 'zstyle user-params and extra-params configure the params' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" user-params "--git --icons"
    zstyle ":zsh-eza:config" extra-params "--tree"
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    eval "${aliases[ls]}"
  '

  assert $state equals 0
  assert "$output" contains 'fake-eza [--git] [--icons] [--tree]'
}

@test 'zstyle autocd enables chpwd hook' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" autocd yes
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    if [[ ${chpwd_functions[(r)_zsh_eza_auto_list]} == _zsh_eza_auto_list ]]; then
      print -- "hook=registered"
    else
      print -- "hook=absent"
    fi
  '

  assert $state equals 0
  assert "$output" contains 'hook=registered'
}

@test 'unload preserves an alias the user changed after load' {
  make_fake_eza

  run_zsh_eza_shell '
    alias ls="ls --color=auto"
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    alias ls="my-own-ls"
    zsh-eza_plugin_unload
    print -- "ls=${aliases[ls]}"
    print -- "ll=${aliases[ll]:-removed}"
  '

  assert $state equals 0
  assert "$output" contains 'ls=my-own-ls'
  assert "$output" contains 'll=removed'
}

@test 'autocd no does not register the chpwd hook' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" autocd no
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    if [[ ${chpwd_functions[(r)_zsh_eza_auto_list]} == _zsh_eza_auto_list ]]; then
      print -- "hook=registered"
    else
      print -- "hook=absent"
    fi
  '

  assert $state equals 0
  assert "$output" contains 'hook=absent'
}

@test 'an empty user-params clears the default params' {
  make_fake_eza

  run_zsh_eza_shell '
    zstyle ":zsh-eza:config" user-params ""
    source "${ZSH_EZA_REPO}/zsh-eza.plugin.zsh"
    eval "${aliases[ls]}"
  '

  assert $state equals 0
  assert "$output" contains 'fake-eza'
  assert "$output" does_not_contain '[--git]'
}
